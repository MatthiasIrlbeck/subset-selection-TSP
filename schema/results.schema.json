          "minimum": 0
        },
        "oracle_tsp_calls": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_subset_calls": {
          "type": "integer",
          "minimum": 0
        },
        "knn_build_seconds": {
          "type": "number",
          "minimum": 0
        },
        "grid_cell_effective_min": {
          "type": "number",
          "minimum": 0
        },
        "grid_cell_effective_max": {
          "type": "number",
          "minimum": 0
        },
        "grid_cell_effective_sum": {
          "type": "number",
          "minimum": 0
        },
        "tsp_seconds": {
          "type": "number",
          "minimum": 0
        },
        "subset_seconds": {
          "type": "number",
          "minimum": 0
        },
        "oracle_gain": {
          "type": "number"
        },
        "elite_restarts": {
          "type": "integer",
