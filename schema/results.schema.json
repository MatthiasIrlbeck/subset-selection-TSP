        },
        "lower_bound_gap_mean": {
          "type": "number",
          "description": "Deprecated schema-13 alias of conditional_two_nn_gap_mean."
        },
        "conditional_two_nn_bound_mean": {
          "type": "number",
          "description": "Mean two-nearest-neighbor lower bound, divided by k, on the tour through the subset selected by the heuristic. It is conditional on that subset and is not a global lower bound on the optimum over all size-k subsets."
        },
        "conditional_two_nn_gap_mean": {
          "type": "number",
          "description": "Mean tour value minus conditional_two_nn_bound_mean. This diagnoses fixed-subset tour ordering and bound looseness, not subset-selection error."
        },
        "cv_mean": {
          "type": "number"
        },
        "cv_stderr": {
          "type": "number"
        },
        "cv_variance_reduction": {
          "type": "number"
