{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aldous subset-selection TSP results",
  "type": "object",
  "required": [
    "schema_version",
    "run_metadata",
    "build_metadata",
    "N",
    "done",
    "target",
    "threads",
    "wall_seconds",
    "mode",
    "distance_backend",
    "oracle_status",
    "p_values",
    "config",
    "search_stats",
    "oracle_call_records",
    "summary",
    "summary_rows",
    "instance_rows"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 13
    },
    "run_metadata": {
      "$ref": "#/$defs/run_metadata"
    },
    "build_metadata": {
      "$ref": "#/$defs/build_metadata"
    },
    "N": {
      "type": "integer",
      "minimum": 3
    },
    "done": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "type": "integer",
      "minimum": 0
    },
    "full_bound_expectation": {
      "type": "number"
    },
    "full_bound_expectation_stderr": {
      "type": "number"
    },
    "full_bound_expectation_samples": {
      "type": "integer",
      "minimum": 0
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "balanced",
        "smallp-region",
        "highp-delete",
        "hybrid"
      ]
    },
    "distance_backend": {
      "enum": [
        "coords_exact_grid_knn",
        "coords_exact_bruteforce_knn"
      ]
    },
    "oracle_status": {
      "type": "string"
    },
    "p_values": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      },
      "minItems": 1
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "search_stats": {
      "$ref": "#/$defs/search_stats"
    },
    "oracle_call_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/oracle_call_record"
      }
    },
    "summary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/summary_row"
      }
    },
    "summary_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary_row_with_p"
      },
      "minItems": 1
    },
    "instance_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instance_row"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "run_metadata": {
      "type": "object",
      "required": [
        "project_version",
        "git_commit",
        "compiler",
        "platform",
        "cpu_model",
        "hardware_threads"
      ],
      "properties": {
        "project_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string"
        },
        "hardware_threads": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "build_metadata": {
      "type": "object",
      "required": [
        "build_type",
        "configured_build_type",
        "cmake_generator",
        "cmake_version",
        "enable_native",
        "enable_sanitizers",
        "enable_warnings",
        "enable_werror",
        "enable_python_tests",
        "low_memory_build",
        "optimization_profile",
        "effective_optimization_level",
        "cxx_flags",
        "cxx_flags_configured",
        "cxx_flags_effective_configured",
        "core_target_compile_options",
        "cli_target_compile_options",
        "cplusplus",
        "target_compile_options",
        "effective_compile_options",
        "source_compile_options"
      ],
      "properties": {
        "build_type": {
          "type": "string"
        },
        "configured_build_type": {
          "type": "string"
        },
        "cmake_generator": {
          "type": "string",
          "minLength": 1
        },
        "cmake_version": {
          "type": "string",
          "minLength": 1
        },
        "enable_native": {
          "type": "boolean"
        },
        "enable_sanitizers": {
          "type": "boolean"
        },
        "enable_warnings": {
          "type": "boolean"
        },
        "enable_werror": {
          "type": "boolean"
        },
        "enable_python_tests": {
          "type": "boolean"
        },
        "low_memory_build": {
          "type": "boolean"
        },
        "optimization_profile": {
          "enum": [
            "release-optimized",
            "low-memory"
          ]
        },
        "cxx_flags": {
          "type": "string"
        },
        "cxx_flags_configured": {
          "type": "string"
        },
        "cxx_flags_effective_configured": {
          "type": "string"
        },
        "core_target_compile_options": {
          "type": "string"
        },
        "cli_target_compile_options": {
          "type": "string"
        },
        "cplusplus": {
          "type": "integer",
          "minimum": 201703
        },
        "target_compile_options": {
          "type": "string"
        },
        "effective_compile_options": {
          "type": "string"
        },
        "source_compile_options": {
          "type": "string"
        },
        "effective_optimization_level": {
          "enum": [
            "O0",
            "O1",
            "O2",
            "O3",
            "Os",
            "Oz",
            "compiler-default",
            "config-dependent",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "N",
        "instances",
        "threads",
        "include_instance_rows",
        "seed",
        "knn_k",
        "knn_backend",
        "grid_cell",
        "tsp_restarts",
        "tsp_ils",
        "tsp_patience",
        "subset_restarts",
        "sa_iters",
        "final_exhaustive_k",
        "exhaustive_two_opt_policy",
        "subset_swap_descent_passes",
        "pair_exchange_passes",
        "ruin_recreate_rounds",
        "path_relink_top",
        "verify_knn_checks",
        "oracle_mode",
        "oracle_resolved",
        "oracle_exec_path",
        "oracle_version",
        "oracle_format",
        "oracle_time_limit_sec",
        "oracle_scale",
        "oracle_min_k",
        "oracle_max_k",
        "oracle_lkh_runs",
        "oracle_lkh_max_trials",
        "oracle_tsp_top",
        "oracle_subset_top",
        "disable_two_opt",
        "disable_or_opt",
        "disable_subset_swap",
        "disable_pair_exchange",
        "disable_ruin_recreate",
        "disable_path_relink",
        "disable_smallp_seeds",
        "disable_highp_delete",
        "oracle_use_for_tsp",
        "oracle_use_for_subset",
        "oracle_inline_feedback",
        "oracle_verbose"
      ],
      "properties": {
        "N": {
          "type": "integer",
          "minimum": 3
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "include_instance_rows": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        },
        "knn_k": {
          "type": "integer",
          "minimum": 1
        },
        "knn_backend": {
          "enum": [
            "coords_exact_grid_knn",
            "coords_exact_bruteforce_knn"
          ]
        },
        "grid_cell": {
          "type": "number",
          "minimum": 0
        },
        "tsp_restarts": {
          "type": "integer",
          "minimum": 1
        },
        "tsp_ils": {
          "type": "integer",
          "minimum": 0
        },
        "tsp_patience": {
          "type": "integer",
          "minimum": 0
        },
        "subset_restarts": {
          "type": "integer",
          "minimum": -1,
          "description": "-1 = auto (8 when p <= 0.08, else 3); values >= 1 configure the base restart population"
        },
        "continuation_restarts": {
          "type": "integer",
          "minimum": 0,
          "description": "Warm/continuation restart quota when a parent subset is available."
        },
        "continuation_policy": {
          "enum": [
            "supplemental",
            "fixed-budget"
          ]
        },
        "racing_candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "Supplemental restart candidates screened by deterministic racing; 0 disables racing."
        },
        "racing_survivors": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of pilot candidates promoted to a full-depth rerun."
        },
        "racing_pilot_iters": {
          "type": "integer",
          "minimum": 0,
          "description": "SA iterations per race pilot, capped by the effective full restart budget."
        },
        "racing_min_jaccard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Preferred minimum selected-set Jaccard distance between promoted candidates."
        },
        "sa_iters": {
          "type": "integer",
          "minimum": 0
        },
        "final_exhaustive_k": {
          "type": "integer",
          "minimum": 0
        },
        "exhaustive_two_opt_policy": {
          "enum": [
            "never",
            "final-only",
            "all-polish"
          ]
        },
        "subset_swap_descent_passes": {
          "type": "integer",
          "minimum": 0
        },
        "pair_exchange_passes": {
          "type": "integer",
          "minimum": 0
        },
        "pair_exchange_max_k": {
          "description": "Maximum subset cardinality for pair exchange; 0 removes the safety gate.",
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "adaptive_ruin_recreate": {
          "type": "boolean",
          "description": "Use the multi-scale ruin/recreate operator portfolio instead of the legacy tiny alternating operators."
        },
        "ruin_recreate_max_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ruin_recreate_max_nodes": {
          "type": "integer",
          "minimum": 0,
          "description": "Absolute adaptive ruin-size cap; 0 removes the absolute cap."
        },
        "ruin_recreate_pool_cap": {
          "type": "integer",
          "minimum": 1
        },
        "path_relink_top": {
          "type": "integer",
          "minimum": 0
        },
        "verify_knn_checks": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_mode": {
          "enum": [
            "none",
            "auto",
            "lkh",
            "concorde"
          ]
        },
        "oracle_resolved": {
          "enum": [
            "none",
            "lkh",
            "concorde"
          ]
        },
        "oracle_exec_path": {
          "type": "string"
        },
        "oracle_version": {
          "type": "string"
        },
        "oracle_format": {
          "enum": [
            "matrix",
            "euc2d"
          ]
        },
        "oracle_time_limit_sec": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_scale": {
          "type": "integer",
          "minimum": 1
        },
        "oracle_min_k": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_max_k": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_lkh_runs": {
          "type": "integer",
          "minimum": 1
        },
        "oracle_lkh_max_trials": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_tsp_top": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_subset_top": {
          "type": "integer",
          "minimum": 0
        },
        "disable_two_opt": {
          "type": "boolean"
        },
        "disable_or_opt": {
          "type": "boolean"
        },
        "disable_subset_swap": {
          "type": "boolean"
        },
        "disable_pair_exchange": {
          "type": "boolean"
        },
        "disable_ruin_recreate": {
          "type": "boolean"
        },
        "disable_path_relink": {
          "type": "boolean"
        },
        "disable_smallp_seeds": {
          "type": "boolean"
        },
        "disable_highp_delete": {
          "type": "boolean"
        },
        "oracle_use_for_tsp": {
          "type": "boolean"
        },
        "oracle_use_for_subset": {
          "type": "boolean"
        },
        "oracle_inline_feedback": {
          "type": "boolean"
        },
        "oracle_verbose": {
          "type": "boolean"
        },
        "sa_iters_per_k": {
          "type": "integer",
          "minimum": 0
        },
        "sa_iters_per_n": {
          "type": "integer",
          "minimum": 0
        },
        "time_budget_per_p": {
          "type": "number",
          "minimum": 0
        },
        "restart_threads": {
          "type": "integer",
          "minimum": 1
        },
        "second_sweep": {
          "type": "boolean"
        },
        "periodic": {
          "type": "boolean"
        },
        "control_variate": {
          "type": "boolean"
        },
        "cv_mc_samples": {
          "type": "integer"
        },
        "held_karp": {
          "type": "boolean"
        },
        "hk_iterations": {
          "type": "integer"
        },
        "sa_t0": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sa_t1": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sa_exact_insertion": {
          "type": "boolean"
        },
        "sa_insertion_window": {
          "type": "integer",
          "minimum": 1
        },
        "kick_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "kick_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "kick_t0": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "region_seeds": {
          "type": "boolean"
        },
        "region_dilation": {
          "type": "number",
          "minimum": 1
        },
        "small_p_dense_fill": {
          "type": "boolean"
        },
        "exploration_exact_insertion": {
          "type": "boolean"
        },
        "sa_spatial_insertion": {
          "type": "boolean"
        },
        "sa_spatial_neighbors": {
          "type": "integer",
          "minimum": 1
        },
        "dense_exact_insertion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "search_stats": {
      "type": "object",
      "required": [
        "tsp_restarts",
        "tsp_ils_iterations",
        "subset_restarts",
        "smallp_seed_restarts",
        "highp_delete_restarts",
        "warm_restarts",
        "random_restarts",
        "two_opt_scans",
        "two_opt_improvements",
        "or_opt_scans",
        "or_opt_improvements",
        "sa_moves",
        "sa_accepted",
        "sa_improving",
        "subset_swap_scans",
        "subset_swap_improvements",
        "highp_exchange_scans",
        "highp_exchange_improvements",
        "pair_exchange_scans",
        "pair_exchange_improvements",
        "ruin_recreate_attempts",
        "ruin_recreate_improvements",
        "path_relink_attempts",
        "path_relink_feasible",
        "path_relink_elite_insertions",
        "path_relink_best_improvements",
        "path_relink_improvements",
        "knn_requested_grid_instances",
        "knn_requested_bruteforce_instances",
        "knn_effective_grid_instances",
        "knn_effective_bruteforce_instances",
        "knn_bruteforce_fallback_instances",
        "knn_grid_cell_capped_instances",
        "knn_grid_cell_samples",
        "knn_grid_cells_sum",
        "knn_grid_cells_max",
        "oracle_calls",
        "oracle_solved",
        "oracle_improved",
        "oracle_failed",
        "oracle_tsp_calls",
        "oracle_subset_calls",
        "knn_build_seconds",
        "grid_cell_effective_min",
        "grid_cell_effective_max",
        "grid_cell_effective_sum",
        "tsp_seconds",
        "subset_seconds",
        "oracle_gain"
      ],
      "properties": {
        "tsp_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "tsp_ils_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "subset_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "smallp_seed_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "highp_delete_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "warm_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "random_restarts": {
          "type": "integer",
          "minimum": 0
        },
        "region_restarts": {
          "description": "Executed subset restarts whose final kind is region.",
          "type": "integer",
          "minimum": 0
        },
        "dense_restarts": {
          "description": "Executed subset restarts whose final kind is dense.",
          "type": "integer",
          "minimum": 0
        },
        "racing_pilot_restarts": {
          "description": "Unique raced candidates that received the fixed screening pilot.",
          "type": "integer",
          "minimum": 0
        },
        "racing_promoted_restarts": {
          "description": "Raced candidates promoted to a full-depth rerun after screening.",
          "type": "integer",
          "minimum": 0
        },
        "two_opt_scans": {
          "type": "integer",
          "minimum": 0
        },
        "two_opt_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "or_opt_scans": {
          "type": "integer",
          "minimum": 0
        },
        "or_opt_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "sa_moves": {
          "type": "integer",
          "minimum": 0
        },
        "sa_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "sa_improving": {
          "type": "integer",
          "minimum": 0
        },
        "subset_swap_scans": {
          "type": "integer",
          "minimum": 0
        },
        "subset_swap_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "highp_exchange_scans": {
          "type": "integer",
          "minimum": 0
        },
        "highp_exchange_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "pair_exchange_scans": {
          "type": "integer",
          "minimum": 0
        },
        "pair_exchange_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "pair_exchange_skipped_large_k": {
          "description": "Pair-exchange invocations skipped by pair_exchange_max_k.",
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_removed_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_worst_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_worst_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_segment_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_segment_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_spatial_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_spatial_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_long_edge_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_long_edge_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_random_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "ruin_recreate_random_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "path_relink_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "path_relink_feasible": {
          "type": "integer",
          "minimum": 0
        },
        "path_relink_elite_insertions": {
          "type": "integer",
          "minimum": 0
        },
        "path_relink_best_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "path_relink_improvements": {
          "type": "integer",
          "minimum": 0
        },
        "knn_requested_grid_instances": {
          "type": "integer",
          "minimum": 0
        },
        "knn_requested_bruteforce_instances": {
          "type": "integer",
          "minimum": 0
        },
        "knn_effective_grid_instances": {
          "type": "integer",
          "minimum": 0
        },
        "knn_effective_bruteforce_instances": {
          "type": "integer",
          "minimum": 0
        },
        "knn_bruteforce_fallback_instances": {
          "type": "integer",
          "minimum": 0
        },
        "knn_grid_cell_capped_instances": {
          "type": "integer",
          "minimum": 0
        },
