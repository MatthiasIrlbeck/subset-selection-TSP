          "description": "Deprecated schema-13 alias of conditional_held_karp_gap_mean."
        },
        "conditional_held_karp_bound_mean": {
          "type": "number",
          "description": "Mean Held-Karp lower bound, divided by k, on the optimal tour through the subset selected by the heuristic. It is not a bound on the optimum over all size-k subsets."
        },
        "conditional_held_karp_gap_mean": {
          "type": "number",
          "description": "Mean tour value minus conditional_held_karp_bound_mean. A small value certifies tour-ordering quality for the selected subsets only."
        }
      },
      "additionalProperties": false
    },
